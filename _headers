# Cloudflare Pages 响应头配置
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# 图片资源：2026-09-22 由 30 天改为 10 分钟。
# 事故：jizhan_cover.jpg 换了两次图，但文件名不变 + 原 30 天强缓存，
# 边缘节点连着 8.7 天一直吐旧图（cf-cache HIT, age=752397），用户看到"没换成"。
# 换图后现在最多 10 分钟自动生效；要立即生效就 purge：
#   POST /zones/519cd5165c4d5a9c7350419ee5f7bb8d/purge_cache  {"files":["<完整URL>"]}
/assets/*
  Cache-Control: public, max-age=600, stale-while-revalidate=3600

# 样式与脚本：使用 ?v= 版本号做缓存刷新，改文件时记得同步改版本号
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 站点图标：给搜索引擎留较短的缓存，方便换图标后及时生效
/favicon.ico
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=604800

/favicon-192.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=604800

# 站点地图与爬虫协议：不要长缓存，方便搜索引擎及时拿到最新版本
/sitemap.xml
  Cache-Control: public, max-age=1800

/robots.txt
  Cache-Control: public, max-age=1800

# ══════════════════════════════════════════════════════════════
# 源码与上传文件：不让搜索引擎收录（2026-09-29 加）
#
# 背景：Cloudflare Pages 把仓库根目录**原样发布**，所以下面这些都能被
#       https://fmbly.com/... 直接下载（2026-09-29 线上实测：/data/articles.js、
#       /scripts/build-articles.js、/LINKS.md、/.baseline-links.tsv 全部返回 200）：
#         /data/*        站点数据（文章、游戏、礼包、资讯）
#         /scripts/*     构建脚本
#         /.uploads/*    上传的素材（含被误提交进仓库的 docx/图片）
#         /.baseline-*   改动核对用的文件清单
#         /LINKS.md      内部文档
#
# 做法：只加 X-Robots-Tag: noindex。
#   ⚠️ 刻意**不在 robots.txt 里 Disallow** —— 爬虫一旦被 robots 禁止抓取，就读不到
#      这个 noindex 头，已经收录的条目反而清不掉。要"移除收录"必须让它能抓、抓到 noindex。
#      只有永远不需要被任何爬虫访问的（如 .baseline-*）才适合 Disallow + noindex 双保险。
#
# ⚠️ 边界说明：这只解决"别出现在搜索结果里"，**解决不了"文件本身公开"** ——
#    本仓库是公开仓库，这些文件在 GitHub 上本来就人人可读。根因治理只有两条：
#    ① 只部署站点文件（改 Pages 的构建输出目录）；② 仓库转私有。都是单独的事，不在本次改动内。
# ══════════════════════════════════════════════════════════════
/data/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=300

/scripts/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=300

/.uploads/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=300

/.baseline-*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=300

/LINKS.md
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=300
