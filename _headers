# Cloudflare Pages 响应头配置
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# 图片资源：2026-09-22 由 30 天改为 10 分钟。
# 事故：jizhan_cover.jpg 换了两次图，但文件名不变 + 原 30 天强缓存，
# 边缘节点连着 8.7 天一直吐旧图（cf-cache HIT, age=752397），用户看到"没换成"。
# 换图后现在最多 10 分钟自动生效；要立即生效就 purge：
#   POST /zones/519cd5165c4d5a9c7350419ee5f7bb8d/purge_cache  {"files":["<完整URL>"]}
/assets/*
  Cache-Control: public, max-age=600, stale-while-revalidate=3600

# 样式与脚本：使用 ?v= 版本号做缓存刷新，改文件时记得同步改版本号
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 站点图标：给搜索引擎留较短的缓存，方便换图标后及时生效
/favicon.ico
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=604800

/favicon-192.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=604800

# 站点地图与爬虫协议：不要长缓存，方便搜索引擎及时拿到最新版本
/sitemap.xml
  Cache-Control: public, max-age=1800

/robots.txt
  Cache-Control: public, max-age=1800

# 内部文件：不该出现在搜索结果里。
# 2026-10-09：robots.txt 里写的是 /admin.html、/_compare.html，但 Cloudflare Pages 的
#   「clean URL」会把 /admin.html 308 到 /admin，爬虫抓到的是 /admin —— 规则没拦住；
#   同理还有 LINKS.md、.baseline-* 构建基线、.github/ 下的工作流状态文件，都能直接被访问到。
#   robots.txt 已在同批补全，这里再加一层 X-Robots-Tag：Cloudflare 后台若开了「托管 robots.txt」，
#   本仓库文件前会被插入受管内容，光靠 robots.txt 并不可靠。
/admin
  X-Robots-Tag: noindex, nofollow
/admin.html
  X-Robots-Tag: noindex, nofollow
/_compare
  X-Robots-Tag: noindex, nofollow
/_compare.html
  X-Robots-Tag: noindex, nofollow
/LINKS.md
  X-Robots-Tag: noindex, nofollow
/.baseline*
  X-Robots-Tag: noindex, nofollow
/.github/*
  X-Robots-Tag: noindex, nofollow
